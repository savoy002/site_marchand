{% extends 'base_admin.html.twig' %}

{% block title %} Types de livraison {% endblock %}

{% block body %} 

	<div class="row">
		<div class="offset-sm-1">
			<h1>Types de livraison de l'entreprise {{ company.name }}.</h1>
		</div>
	</div>

	<div class="row">
		<div class="offset-sm-1"
			<nav aria-label="breadcrumb">
			  <ol class="breadcrumb">
			    <li class="breadcrumb-item"><a href="{{ path("menu_delivery") }}">Menu Livraison</a></li>
			    <li class="breadcrumb-item"><a href="{{ path("companies_deliveries") }}">Entreprise de livraison</a></li>
			    <li class="breadcrumb-item"><a href="{{ path("company_delivery", {id:company.id}) }}">{{ company.name }}</a></li>
			    <li class="breadcrumb-item active" aria-current="page">Types de livraison</li>
			  </ol>
			</nav>
		</div>
	</div>

	<div class="row justify-content-start offset-1">

		{% if types.getTotalItemCount != 0 %}

			<div class="row">
				<div class="col-10 offset-1 table-responsive">
					<table class="table table-bordered">
						<thead class="thead-dark">
							<tr>
								<th>Nom du type</th>
								<th>Prix</th>
								<th>Temps</th>
								<th>Activitée</th>
								<th>Voir</th>
							</tr>
						</thead>
						<tbody>
							{% for type in company.types %}
								<tr>
									<td>{{ type.name }}</td>
									<td>
										{% set price = type.price %}
										{{ include('structure/price/price.html.twig') }}
									</td>
									<td>{{ type.timeMin ~ " à " ~ type.timeMax ~ " jours" }}</td>
									<td>{{ (type.activate)?('Actif'):('Inactif') }}</td>
									<td><a class="btn btn-info" href="{{ path("type_delivery", {id:type.id}) }}">Voir</a></td>
								</tr>
							{% endfor %}
						</tbody>
					</table>

					<div class="row justify-content-around">
					    {{ knp_pagination_render(types) }}
					</div>

				</div>
			</div>

		{% else %}

			<div class="col-12 justify-content-center">
				<p>L'entreprise {{ company.name }} n'a pas de type de livraison.</p>
			</div>

		{% endif %}

		<div class="{{ (types.getTotalItemCount != 0)?('col offset-sm-1'):('col-12') }}">
			<a href="{{ path("create_type_delivery") }}" class="btn btn-primary">Créer un type</a>
		</div>

	</div>


{% endblock %}
