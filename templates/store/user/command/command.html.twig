{% extends 'base.html.twig' %}

{% block title %} Commande {% endblock %}

{% block body %}
	
	<div class="row div-title">
		<div class="col offset-2 ">
			<h1>Commande numéro {{ command.id }}.</h1>
		</div>
	</div>

	<div class="row">
		<div class="col offset-2">
			<div class="row">
				<div class="col">
					<h4>
						{#Créer le : {{ command.createdAt|format_datetime('full', 'none', locale='fr') }}. #}
						Créer le : {{ command.createdAt|date("d/m/Y") }}.
					</h4>
				</div>
			</div>
			<div class="row">
				<div class="col">
					<h4>
						{{ (command.delivery is null)?
						   ('Pas encore envoyée'):
						   ('Envoyée le : ' ~ command.delivery.date|date("d/m/Y")) }}.
					</h4>
				</div>
			</div>
			<div class="row">
				<div class="col">
					<h4>
						{{ (command.dateReceive is null)?
						   ('Non reçu'):
						   ('Reçu le : ' ~ command.dateReceive|date("d/m/Y")) }}.
					</h4>
				</div>
			</div>
			<div class="row">
				<div class="col">
					<h4>Adresse de livraison.</h4>
					<p>{{ command.placeDel.street }}</p>
					<p>{{ command.placeDel.zipCode }} {{ command.placeDel.city }}</p>
				</div>
			</div>
			<div class="row">
				<div class="col">
					<h4>Livraison choisie : </h4>
					<p>
						<img src="{{ asset('img/uploads/Command/CompanyDelivery/' ~ command.typeDelSelected.typeDelivery.company.logoFileName) }}"
							width="60" height="60" />
						{{ command.typeDelSelected.typeDelivery.name }}
						{% set price = command.typeDelSelected.priceDelivery %}
						{{ include('structure/price/price.html.twig') }}
					</p>
				</div>
			</div>
			<div class="row">
				<div class="col">
					<h4>Les produits commandés.</h4>
					<div class="row">
						{% for piece_product in command.products %}
							<div class="col-12">
								<p>
									{{ piece_product.nbProducts }}
									{% if piece_product.product.delete %}
										{{ piece_product.product.name }} (le produit n'est plus en vente)
									{% else %}
										{% if piece_product.product.activate %}
											<a href="{{ path('store_product', {code:piece_product.product.code}) }}">
												{{ piece_product.product.name }}
											</a>
										{% else %}
											{{ piece_product.product.name }} (le produit est temporairement retiré des ventes)
										{% endif %}
									{% endif %}
									{% set price = piece_product.priceProduct %}
									{{ include('structure/price/price.html.twig') }}
								</p>
							</div>
						{% endfor %}
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col">
					{% set price = command.priceTotal %}
					<h4>Le prix totale est de : {{ include('structure/price/price.html.twig') }}</h4>
				</div>
			</div>
		</div>
	</div>

{% endblock %}

